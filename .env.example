# ---- Toss Book environment ----
# Copy this file to ".env" and set real values before going live.

# The single admin account created on first run (empty database).
ADMIN_USERNAME=admin
# Use a long, unique password. If unset, the app falls back to "admin123" and warns.
ADMIN_PASSWORD=change-this-to-a-strong-password

# The admin's opening "house float" (₹) — the pool it funds clients from.
ADMIN_FLOAT=1000000000

# Standard Next.js production flag (set automatically by most hosts).
NODE_ENV=production

# Set to 1 ONLY when serving over plain http:// (e.g. a bare-IP VPS without TLS)
# so the session cookie isn't marked Secure (which browsers drop over HTTP).
# Leave unset on any https:// host.
ALLOW_INSECURE_COOKIES=

# ---- Telegram deposit/withdraw notifications (optional) ----
# When both are set, a client's Deposit/Withdraw request is delivered straight to
# the admin's Telegram chat via a bot. If unset, the client is instead redirected
# to Telegram with the request message pre-filled to send manually.
#   1. Create a bot with @BotFather → copy its token into TELEGRAM_BOT_TOKEN.
#   2. Send the bot any message, then open
#      https://api.telegram.org/bot<token>/getUpdates to read your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Admin's public Telegram @username, used for the manual-redirect fallback.
NEXT_PUBLIC_TELEGRAM_ADMIN=RSTOSSBOOK01

# ---- Litestream DB backup (optional, but recommended on ephemeral hosts) ----
# When LITESTREAM_BUCKET is set, the SQLite DB is continuously replicated to an
# S3-compatible bucket and restored on every boot, so data survives redeploys.
# Works with Backblaze B2, Cloudflare R2, AWS S3, etc.
#   B2 example:  ENDPOINT=https://s3.us-west-004.backblazeb2.com  REGION=us-west-004
#   R2 example:  ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  REGION=auto
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
